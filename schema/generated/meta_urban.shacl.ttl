meta_urban:Convention a sh:NodeShape ;
	rdfs:comment "A rule the publisher applies to many variables at once, such as a naming pattern for imputation flags, a code that means \"not applicable\", or a unit used for all energy totals. Conventions are usually stated once in a user guide and never in the individual codebook entries, so a person or an AI system reading one entry cannot infer them; the profile states them explicitly." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n73 ;
	sh:property _:c14n109 , _:c14n141 , _:c14n98 ;
	sh:targetClass meta_urban:Convention .
