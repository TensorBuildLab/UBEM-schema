ubem_link:quantity_kind a owl:DatatypeProperty ;
	rdfs:label "quantity_kind" ;
	skos:definition "QUDT quantity kind CURIE, e.g. quantitykind:Area." ;
	skos:inScheme ubem_link:schema .
ubem_link:record_count a owl:DatatypeProperty ;
	rdfs:label "record_count" ;
	rdfs:range xsd:integer ;
	skos:definition "Number of records (rows, buildings, meters or stations) in the dataset." ;
	skos:inScheme ubem_link:schema .
ubem_link:record_count_note a owl:DatatypeProperty ;
	rdfs:label "record_count_note" ;
	skos:definition "What the record count counts and its source." ;
	skos:inScheme ubem_link:schema .
ubem_link:reference_paper_doi a owl:DatatypeProperty ;
	rdfs:label "reference_paper_doi" ;
	rdfs:range _:c14n211 ;
	skos:definition "DOI of a peer-reviewed paper that describes the dataset." ;
	skos:inScheme ubem_link:schema .
ubem_link:registration_required a owl:DatatypeProperty ;
	rdfs:label "registration_required" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if users must register or sign in before downloading." ;
	skos:inScheme ubem_link:schema .
ubem_link:related_match a owl:DatatypeProperty ;
	rdfs:label "related_match" ;
	skos:definition "Term in another standard that is associated but not equivalent (SKOS relatedMatch)." ;
	skos:inScheme ubem_link:schema .
ubem_link:rule a owl:DatatypeProperty ;
	rdfs:label "rule" ;
	skos:definition "The convention, stated as a rule that can be applied without other context." ;
	skos:inScheme ubem_link:schema .
ubem_link:sampling_weights a owl:DatatypeProperty ;
	rdfs:label "sampling_weights" ;
	skos:definition "Weight variables and how to use them (required for weighted sample surveys)." ;
	skos:inScheme ubem_link:schema .
ubem_link:schema.owl.ttl dct:license "CC-BY-4.0" ;
	dct:title "UBEM-Link metadata schema for open data in urban building energy modeling" ;
	pav:version "1.0.0" ;
	a owl:Ontology ;
	rdfs:label "ubem_link" ;
	rdfs:seeAlso <https://github.com/TensorBuildLab/UBEM-schema> ;
	skos:definition "UBEM-Link describes open datasets used in urban building energy modeling (UBEM) at two levels. The dataset level (DatasetProfile) is an application profile of W3C DCAT 3 with UBEM-specific facets: the UBEM workflow role, statistical nature, spatial granularity, temporal resolution, access level and join keys. The variable level (VariableProfile) records what each column means for UBEM: the concept it maps to in the UBEM-Link vocabulary, its unit (QUDT), its code list, its aggregation semantics, and whether it is a survey weight or an imputation flag. Concepts (UBEMConcept) form a SKOS hierarchy and carry mappings to BEDES, Brick, CityGML Energy ADE and EnergyPlus input objects." .
ubem_link:short_name a owl:DatatypeProperty ;
	rdfs:label "short_name" ;
	skos:definition "Common short name or acronym of the dataset (for example CBECS 2018)." ;
	skos:inScheme ubem_link:schema .
ubem_link:sources_checked a owl:DatatypeProperty ;
	rdfs:label "sources_checked" ;
	rdfs:range xsd:anyURI ;
	skos:definition "Pages and documents consulted during verification." ;
	skos:inScheme ubem_link:schema .
ubem_link:spatial_coverage a owl:ObjectProperty ;
	rdfs:label "spatial_coverage" ;
	rdfs:range ubem_link:SpatialCoverage ;
	skos:definition "Area the dataset covers, as countries and optional regions." ;
	skos:inScheme ubem_link:schema .
ubem_link:spatial_granularity a owl:ObjectProperty ;
	rdfs:label "spatial_granularity" ;
	rdfs:range ubem_link:SpatialGranularity ;
	skos:definition "Finest location detail released publicly." ;
	skos:inScheme ubem_link:schema .
ubem_link:start a owl:DatatypeProperty ;
	rdfs:label "start" ;
	skos:definition "First period covered (ISO 8601 year, month or date)." ;
	skos:inScheme ubem_link:schema .
ubem_link:statistical_nature a owl:ObjectProperty ;
	rdfs:label "statistical_nature" ;
	rdfs:range ubem_link:StatisticalNature ;
	skos:definition "How the data were generated, which decides how they may be analyzed (for example a weighted sample survey must be analyzed with its weights)." ;
	skos:inScheme ubem_link:schema .
ubem_link:temporal_coverage a owl:ObjectProperty ;
	rdfs:label "temporal_coverage" ;
	rdfs:range ubem_link:TemporalCoverage ;
	skos:definition "Period the data describe." ;
	skos:inScheme ubem_link:schema .
ubem_link:temporal_resolution a owl:DatatypeProperty ;
	rdfs:label "temporal_resolution" ;
	rdfs:range _:c14n96 ;
	skos:definition "ISO 8601 duration of the finest time step, or \"static\" or \"irregular\"." ;
	skos:inScheme ubem_link:schema .
ubem_link:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "Full title of the dataset as given by its publisher." ;
	skos:inScheme ubem_link:schema .
ubem_link:ubem_roles a owl:ObjectProperty ;
	rdfs:label "ubem_roles" ;
	rdfs:range ubem_link:UBEMRole ;
	skos:definition "UBEM workflow steps the dataset feeds; first value is the primary role." ;
	skos:inScheme ubem_link:schema .
ubem_link:unit a owl:DatatypeProperty ;
	rdfs:label "unit" ;
	skos:definition "QUDT unit CURIE, e.g. unit:FT2, unit:KiloBTU_IT, unit:KiloW-HR, unit:DEG_C." ;
	skos:inScheme ubem_link:schema .
ubem_link:unit_multiplier a owl:DatatypeProperty ;
	rdfs:label "unit_multiplier" ;
	rdfs:range xsd:float ;
	skos:definition "Factor applied to raw values before the unit applies (e.g., 1000 for \"thousand Btu\")." ;
	skos:inScheme ubem_link:schema .
ubem_link:unit_of_observation a owl:DatatypeProperty ;
	rdfs:label "unit_of_observation" ;
	skos:definition "What one record describes (building, meter, household, station, grid_cell, region, person_day, ...)." ;
	skos:inScheme ubem_link:schema .
ubem_link:update_frequency a owl:DatatypeProperty ;
	rdfs:label "update_frequency" ;
	skos:definition "How often the publisher releases new data (for example annual, irregular)." ;
	skos:inScheme ubem_link:schema .
ubem_link:variables a owl:ObjectProperty ;
	rdfs:label "variables" ;
	rdfs:range ubem_link:VariableProfile ;
	skos:definition "Variable-level profiles of the dataset's columns." ;
	skos:inScheme ubem_link:schema .
ubem_link:variables_documented a owl:DatatypeProperty ;
	rdfs:label "variables_documented" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if the publisher documents every variable (codebook or data dictionary)." ;
	skos:inScheme ubem_link:schema .
ubem_link:verified a owl:ObjectProperty ;
	rdfs:label "verified" ;
	rdfs:range ubem_link:Verification ;
	skos:definition "Provenance of the profile: who checked it, when and against which sources." ;
	skos:inScheme ubem_link:schema .
ubem_link:versioned a owl:DatatypeProperty ;
	rdfs:label "versioned" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if the publisher identifies releases with versions." ;
	skos:inScheme ubem_link:schema .
