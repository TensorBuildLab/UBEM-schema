skos:broadMatch a owl:Class ;
	rdfs:label "broadMatch" ;
	rdfs:subClassOf ubem_link:MappingRelation ;
	skos:definition "The concept is more general than the variable." .
skos:closeMatch a owl:Class ;
	rdfs:label "closeMatch" ;
	rdfs:subClassOf ubem_link:MappingRelation ;
	skos:definition "The variable measures nearly the concept and can be used in its place in most applications." .
skos:exactMatch a owl:Class ;
	rdfs:label "exactMatch" ;
	rdfs:subClassOf ubem_link:MappingRelation ;
	skos:definition "The variable measures exactly the concept." .
skos:narrowMatch a owl:Class ;
	rdfs:label "narrowMatch" ;
	rdfs:subClassOf ubem_link:MappingRelation ;
	skos:definition "The concept is more specific than the variable." .
skos:relatedMatch a owl:Class ;
	rdfs:label "relatedMatch" ;
	rdfs:subClassOf ubem_link:MappingRelation ;
	skos:definition "The variable is associated with the concept but does not measure it." .
ubem_link:AccessLevel\#open_api a owl:Class ;
	rdfs:label "open_api" ;
	rdfs:subClassOf ubem_link:AccessLevel ;
	skos:definition "Data can be retrieved by anyone through an open programmatic interface." .
ubem_link:AccessLevel\#open_download a owl:Class ;
	rdfs:label "open_download" ;
	rdfs:subClassOf ubem_link:AccessLevel ;
	skos:definition "Files can be downloaded by anyone without registration." .
ubem_link:AccessLevel\#registration_required a owl:Class ;
	rdfs:label "registration_required" ;
	rdfs:subClassOf ubem_link:AccessLevel ;
	skos:definition "Free, but users must register or sign in." .
ubem_link:AccessLevel\#request_or_agreement a owl:Class ;
	rdfs:label "request_or_agreement" ;
	rdfs:subClassOf ubem_link:AccessLevel ;
	skos:definition "Access requires an application, a data-use agreement or approval." .
ubem_link:AccessLevel\#restricted_commercial a owl:Class ;
	rdfs:label "restricted_commercial" ;
	rdfs:subClassOf ubem_link:AccessLevel ;
	skos:definition "Access requires payment or is restricted to specific users." .
ubem_link:AccessLevel a owl:Class ;
	rdfs:label "AccessLevel" ;
	owl:unionOf _:c14n302 ;
	skos:definition "How the data can be obtained." ;
	skos:inScheme ubem_link:schema ;
	linkml:permissible_values ubem_link:AccessLevel\#open_api , ubem_link:AccessLevel\#open_download , ubem_link:AccessLevel\#registration_required , ubem_link:AccessLevel\#request_or_agreement , ubem_link:AccessLevel\#restricted_commercial .
ubem_link:Aggregation\#average_over_period a owl:Class ;
	rdfs:label "average_over_period" ;
	rdfs:subClassOf ubem_link:Aggregation ;
	skos:definition "Mean over the reporting period." .
ubem_link:Aggregation\#count a owl:Class ;
	rdfs:label "count" ;
	rdfs:subClassOf ubem_link:Aggregation ;
	skos:definition "Number of items (for example number of floors or occupants)." .
ubem_link:Aggregation\#instantaneous a owl:Class ;
	rdfs:label "instantaneous" ;
	rdfs:subClassOf ubem_link:Aggregation ;
