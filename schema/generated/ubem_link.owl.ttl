ubem_link:CategoryProfile a owl:Class ;
	rdfs:label "CategoryProfile" ;
	rdfs:subClassOf _:c14n202 , _:c14n293 , _:c14n350 , _:c14n382 , _:c14n587 ;
	skos:definition "Category-specific part of a dataset profile: what a modeler must know about one kind of UBEM data before using it. There is one profile class per UBEM workflow role. The classes refine the per-category metadata table of an earlier taxonomy of open UBEM data: its free-text fields became typed fields with closed value lists, its \"macroscopic\" and \"microscopic\" energy data share EnergyProfile and differ in energy_data_scale, and its \"comprehensive data lake\" is a Catalog of profiles rather than a category." ;
	skos:inScheme ubem_link:schema .
ubem_link:CharacteristicsProfile a owl:Class ;
	rdfs:label "CharacteristicsProfile" ;
	rdfs:subClassOf ubem_link:CategoryProfile , _:c14n116 , _:c14n203 , _:c14n285 , _:c14n305 , _:c14n342 , _:c14n372 , _:c14n393 , _:c14n395 , _:c14n428 , _:c14n468 , _:c14n545 , _:c14n66 ;
