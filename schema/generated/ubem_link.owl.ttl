ubem_link:Catalog a owl:Class ;
	rdfs:label "Catalog" ;
	rdfs:subClassOf _:c14n290 , _:c14n30 , _:c14n32 , _:c14n88 ;
	skos:definition "A collection of dataset profiles and the concept vocabulary they refer to." ;
	skos:exactMatch dcat:Catalog ;
	skos:inScheme ubem_link:schema .
ubem_link:CodeEntry a owl:Class ;
	rdfs:label "CodeEntry" ;
	rdfs:subClassOf _:c14n12 , _:c14n142 , _:c14n223 , _:c14n227 , _:c14n24 , _:c14n248 , _:c14n253 , _:c14n270 , _:c14n56 ;
	skos:definition "One code of a categorical variable and its meaning." ;
	skos:exactMatch skos:Concept ;
	skos:inScheme ubem_link:schema .
ubem_link:Convention a owl:Class ;
	rdfs:label "Convention" ;
	rdfs:subClassOf _:c14n150 , _:c14n170 , _:c14n2 , _:c14n234 , _:c14n243 , _:c14n293 , _:c14n314 , _:c14n74 , _:c14n91 ;
	skos:definition "A rule the publisher applies to many variables at once, such as a naming pattern for imputation flags, a code that means \"not applicable\", or a unit used for all energy totals. Conventions are usually stated once in a user guide and never in the individual codebook entries, so a person or an AI system reading one entry cannot infer them; the profile states them explicitly." ;
	skos:inScheme ubem_link:schema .
