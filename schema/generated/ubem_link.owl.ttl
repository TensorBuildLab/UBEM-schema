ubem_link:ConventionType\#missing_code a owl:Class ;
	rdfs:label "missing_code" ;
	rdfs:subClassOf ubem_link:ConventionType ;
	skos:definition "Codes that mean missing, not applicable, withheld or unknown." .
ubem_link:ConventionType\#top_or_bottom_code a owl:Class ;
	rdfs:label "top_or_bottom_code" ;
	rdfs:subClassOf ubem_link:ConventionType ;
	skos:definition "Codes that stand for ranges at the end of a scale." .
ubem_link:ConventionType\#unit a owl:Class ;
	rdfs:label "unit" ;
	rdfs:subClassOf ubem_link:ConventionType ;
	skos:definition "The unit and multiplier of values." .
ubem_link:ConventionType\#weight a owl:Class ;
	rdfs:label "weight" ;
	rdfs:subClassOf ubem_link:ConventionType ;
	skos:definition "How weights are named and used." .
ubem_link:ConventionType a owl:Class ;
	rdfs:label "ConventionType" ;
	owl:unionOf _:c14n304 ;
	skos:definition "What a dataset convention concerns." ;
	skos:inScheme ubem_link:schema ;
	linkml:permissible_values ubem_link:ConventionType\#definition , ubem_link:ConventionType\#do_not_use , ubem_link:ConventionType\#identifier_format , ubem_link:ConventionType\#imputation_flag , ubem_link:ConventionType\#missing_code , ubem_link:ConventionType\#top_or_bottom_code , ubem_link:ConventionType\#unit , ubem_link:ConventionType\#weight .
