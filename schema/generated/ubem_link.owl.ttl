	skos:definition "True if the variable records whether another variable was imputed." ;
	skos:inScheme ubem_link:schema .
ubem_link:is_replicate_weight a owl:DatatypeProperty ;
	rdfs:label "is_replicate_weight" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if the variable is a replicate weight used to estimate sampling variance." ;
	skos:inScheme ubem_link:schema .
ubem_link:is_weight a owl:DatatypeProperty ;
	rdfs:label "is_weight" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if the variable is a sampling or analysis weight; such variables are not observations." ;
	skos:inScheme ubem_link:schema .
ubem_link:join_key a owl:ObjectProperty ;
	rdfs:label "join_key" ;
	rdfs:range ubem_link:JoinKey ;
	skos:definition "Key type the variable holds, if it can link records to other datasets (for example parcel_id for a tax-lot number)." ;
	skos:inScheme ubem_link:schema .
ubem_link:join_keys a owl:ObjectProperty ;
	rdfs:label "join_keys" ;
	rdfs:range ubem_link:JoinKey ;
	skos:definition "Keys present in the public data that allow records to be linked to other datasets." ;
	skos:inScheme ubem_link:schema .
ubem_link:known_limitations a owl:DatatypeProperty ;
	rdfs:label "known_limitations" ;
	skos:definition "Limitations a user must know before using the data (bias, coverage gaps, suppression)." ;
	skos:inScheme ubem_link:schema .
ubem_link:label a owl:DatatypeProperty ;
	rdfs:label "label" ;
	skos:definition "Short human-readable label of the variable as given in the codebook." ;
	skos:inScheme ubem_link:schema .
ubem_link:landing_page a owl:DatatypeProperty ;
	rdfs:label "landing_page" ;
	rdfs:range xsd:anyURI ;
	skos:definition "Web page of the dataset maintained by the publisher." ;
	skos:inScheme ubem_link:schema .
ubem_link:levels_of_detail a owl:ObjectProperty ;
	rdfs:label "levels_of_detail" ;
	rdfs:range ubem_link:LevelOfDetail ;
	skos:definition "CityGML levels of detail provided." ;
	skos:inScheme ubem_link:schema .
ubem_link:license a owl:DatatypeProperty ;
	rdfs:label "license" ;
	skos:definition "License or terms of use, as stated by the publisher (SPDX identifier where one exists)." ;
	skos:inScheme ubem_link:schema .
ubem_link:machine_readable a owl:DatatypeProperty ;
	rdfs:label "machine_readable" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if the data are released in a machine-readable format, not only as reports." ;
	skos:inScheme ubem_link:schema .
ubem_link:mapping_relation a owl:ObjectProperty ;
	rdfs:label "mapping_relation" ;
	rdfs:range ubem_link:MappingRelation ;
	skos:definition "SKOS relation between the variable and its concept (exact, close, broad, narrow, related)." ;
	skos:inScheme ubem_link:schema .
ubem_link:measurement_basis a owl:ObjectProperty ;
	rdfs:label "measurement_basis" ;
	rdfs:range ubem_link:MeasurementBasis ;
	skos:definition "Whether values are metered, billed, self-reported or modeled." ;
	skos:inScheme ubem_link:schema .
ubem_link:metadata_standards a owl:DatatypeProperty ;
	rdfs:label "metadata_standards" ;
	skos:definition "Metadata standards or schemas the publisher already uses (for example Brick, BuildingSync, DDI-Codebook, CityGML)." ;
	skos:inScheme ubem_link:schema .
ubem_link:metering_level a owl:ObjectProperty ;
	rdfs:label "metering_level" ;
	rdfs:range ubem_link:MeteringLevel ;
	skos:definition "Finest level at which energy is measured or reported." ;
	skos:inScheme ubem_link:schema .
ubem_link:minimum_building_size a owl:DatatypeProperty ;
	rdfs:label "minimum_building_size" ;
	skos:definition "Capture threshold for buildings, as stated by the publisher (for example 'larger than 400 sq ft')." ;
	skos:inScheme ubem_link:schema .
ubem_link:missing_codes a owl:DatatypeProperty ;
	rdfs:label "missing_codes" ;
	skos:definition "Raw values that mean missing, not applicable, or suppressed." ;
	skos:inScheme ubem_link:schema .
ubem_link:name a owl:DatatypeProperty ;
	rdfs:label "name" ;
	skos:definition "Variable name exactly as it appears in the data file." ;
	skos:inScheme ubem_link:schema .
ubem_link:narrow_match a owl:DatatypeProperty ;
	rdfs:label "narrow_match" ;
	skos:definition "Term in another standard that is more specific (SKOS narrowMatch)." ;
	skos:inScheme ubem_link:schema .
ubem_link:notes a owl:DatatypeProperty ;
	rdfs:label "notes" ;
	skos:definition "Other information about the dataset or about how its profile was verified." ;
	skos:inScheme ubem_link:schema .
ubem_link:operation_profile a owl:ObjectProperty ;
	rdfs:label "operation_profile" ;
	rdfs:range ubem_link:OperationProfile ;
	skos:definition "Category profile for a dataset with the role operation_use." ;
	skos:inScheme ubem_link:schema .
ubem_link:persistent_identifier a owl:DatatypeProperty ;
	rdfs:label "persistent_identifier" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if the dataset has a persistent identifier such as a DOI." ;
	skos:inScheme ubem_link:schema .
ubem_link:pref_label a owl:DatatypeProperty ;
	rdfs:label "pref_label" ;
	skos:definition "Preferred human-readable label of the concept." ;
	skos:inScheme ubem_link:schema .
ubem_link:profiled_by a owl:DatatypeProperty ;
	rdfs:label "profiled_by" ;
	skos:definition "Who or what produced this variable profile (a person, or a model id such as ollama:qwen3:8b), and whether it was reviewed." ;
	skos:inScheme ubem_link:schema .
ubem_link:provides_concepts a owl:DatatypeProperty ;
	rdfs:label "provides_concepts" ;
	skos:definition "Ids of the UBEM-Link concepts the dataset provides values for (its content at concept level)." ;
	skos:inScheme ubem_link:schema .
ubem_link:publisher a owl:DatatypeProperty ;
	rdfs:label "publisher" ;
	skos:definition "Organization that publishes and maintains the dataset." ;
	skos:inScheme ubem_link:schema .
ubem_link:quantity_kind a owl:DatatypeProperty ;
	rdfs:label "quantity_kind" ;
	skos:definition "QUDT quantity kind CURIE, e.g. quantitykind:Area." ;
	skos:inScheme ubem_link:schema .
ubem_link:record_count a owl:DatatypeProperty ;
	rdfs:label "record_count" ;
	rdfs:range xsd:integer ;
	skos:definition "Number of records (rows, buildings, meters or stations) in the dataset." ;
	skos:inScheme ubem_link:schema .
ubem_link:record_count_note a owl:DatatypeProperty ;
	rdfs:label "record_count_note" ;
	skos:definition "What the record count counts and its source." ;
	skos:inScheme ubem_link:schema .
ubem_link:reference_paper_doi a owl:DatatypeProperty ;
	rdfs:label "reference_paper_doi" ;
	rdfs:range _:c14n390 ;
	skos:definition "DOI of a peer-reviewed paper that describes the dataset." ;
	skos:inScheme ubem_link:schema .
ubem_link:registration_required a owl:DatatypeProperty ;
	rdfs:label "registration_required" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if users must register or sign in before downloading." ;
	skos:inScheme ubem_link:schema .
ubem_link:related_match a owl:DatatypeProperty ;
	rdfs:label "related_match" ;
	skos:definition "Term in another standard that is associated but not equivalent (SKOS relatedMatch)." ;
	skos:inScheme ubem_link:schema .
ubem_link:reporting_period a owl:DatatypeProperty ;
	rdfs:label "reporting_period" ;
	skos:definition "Period one value covers (for example calendar year, billing month)." ;
	skos:inScheme ubem_link:schema .
ubem_link:representativeness a owl:ObjectProperty ;
	rdfs:label "representativeness" ;
	rdfs:range ubem_link:Representativeness ;
	skos:definition "How the covered buildings relate to the building stock, which decides whether results generalize." ;
	skos:inScheme ubem_link:schema .
ubem_link:review_flags a owl:DatatypeProperty ;
	rdfs:label "review_flags" ;
	skos:definition "Reasons this profile should be reviewed by a person (failed checks, low confidence, disagreement)." ;
	skos:inScheme ubem_link:schema .
ubem_link:rule a owl:DatatypeProperty ;
	rdfs:label "rule" ;
	skos:definition "The convention, stated as a rule that can be applied without other context." ;
	skos:inScheme ubem_link:schema .
ubem_link:sampling_weights a owl:DatatypeProperty ;
	rdfs:label "sampling_weights" ;
	skos:definition "Weight variables and how to use them (required for weighted sample surveys)." ;
	skos:inScheme ubem_link:schema .
ubem_link:schema.owl.ttl dct:license "CC-BY-4.0" ;
	dct:title "UBEM-Link metadata schema for open data in urban building energy modeling" ;
	pav:version "1.0.0" ;
	a owl:Ontology ;
	rdfs:label "ubem_link" ;
	rdfs:seeAlso <https://github.com/TensorBuildLab/UBEM-schema> ;
	skos:definition "UBEM-Link describes open datasets used in urban building energy modeling (UBEM) at two levels. The dataset level (DatasetProfile) is an application profile of W3C DCAT 3 with UBEM-specific facets: the UBEM workflow role, statistical nature, spatial granularity, temporal resolution, access level and join keys. The variable level (VariableProfile) records what each column means for UBEM: the concept it maps to in the UBEM-Link vocabulary, its unit (QUDT), its code list, its aggregation semantics, and whether it is a survey weight or an imputation flag. Concepts (UBEMConcept) form a SKOS hierarchy and carry mappings to BEDES, Brick, CityGML Energy ADE and EnergyPlus input objects. Between the two levels, one category profile per UBEM workflow role (WeatherProfile, GeometryProfile, OperationProfile, CharacteristicsProfile, EnergyProfile, SimulationProfile, ContextProfile) records what a modeler must know about that kind of data. The roles and category profiles refine an earlier seven-category taxonomy of open UBEM data (weather information; building stock GIS; occupant behavior; building characteristics; macroscopic energy; microscopic energy; comprehensive data lakes) and its per-category metadata table." .
ubem_link:short_name a owl:DatatypeProperty ;
	rdfs:label "short_name" ;
	skos:definition "Common short name or acronym of the dataset (for example CBECS 2018)." ;
	skos:inScheme ubem_link:schema .
ubem_link:simulation_engine a owl:DatatypeProperty ;
	rdfs:label "simulation_engine" ;
	skos:definition "Simulation engine that produced the data (for example EnergyPlus)." ;
	skos:inScheme ubem_link:schema .
ubem_link:simulation_profile a owl:ObjectProperty ;
	rdfs:label "simulation_profile" ;
	rdfs:range ubem_link:SimulationProfile ;
	skos:definition "Category profile for a dataset with the role reference_simulation." ;
	skos:inScheme ubem_link:schema .
ubem_link:sources_checked a owl:DatatypeProperty ;
	rdfs:label "sources_checked" ;
	rdfs:range xsd:anyURI ;
	skos:definition "Pages and documents consulted during verification." ;
	skos:inScheme ubem_link:schema .
ubem_link:spatial_coverage a owl:ObjectProperty ;
	rdfs:label "spatial_coverage" ;
	rdfs:range ubem_link:SpatialCoverage ;
	skos:definition "Area the dataset covers, as countries and optional regions." ;
	skos:inScheme ubem_link:schema .
ubem_link:spatial_granularity a owl:ObjectProperty ;
	rdfs:label "spatial_granularity" ;
	rdfs:range ubem_link:SpatialGranularity ;
	skos:definition "Finest location detail released publicly." ;
	skos:inScheme ubem_link:schema .
ubem_link:start a owl:DatatypeProperty ;
	rdfs:label "start" ;
	skos:definition "First period covered (ISO 8601 year, month or date)." ;
	skos:inScheme ubem_link:schema .
ubem_link:station_id_scheme a owl:DatatypeProperty ;
	rdfs:label "station_id_scheme" ;
	skos:definition "Identifier system of the stations (for example WMO, USAF-WBAN, GHCN)." ;
	skos:inScheme ubem_link:schema .
ubem_link:statistical_nature a owl:ObjectProperty ;
	rdfs:label "statistical_nature" ;
	rdfs:range ubem_link:StatisticalNature ;
	skos:definition "How the data were generated, which decides how they may be analyzed (for example a weighted sample survey must be analyzed with its weights)." ;
	skos:inScheme ubem_link:schema .
ubem_link:stock_representation a owl:ObjectProperty ;
	rdfs:label "stock_representation" ;
	rdfs:range ubem_link:StockRepresentation ;
	skos:definition "How the simulated building stock is represented." ;
	skos:inScheme ubem_link:schema .
ubem_link:temporal_coverage a owl:ObjectProperty ;
	rdfs:label "temporal_coverage" ;
	rdfs:range ubem_link:TemporalCoverage ;
	skos:definition "Period the data describe." ;
	skos:inScheme ubem_link:schema .
ubem_link:temporal_resolution a owl:DatatypeProperty ;
	rdfs:label "temporal_resolution" ;
	rdfs:range _:c14n178 ;
	skos:definition "ISO 8601 duration of the finest time step, or \"static\" or \"irregular\"." ;
	skos:inScheme ubem_link:schema .
ubem_link:time_basis a owl:ObjectProperty ;
	rdfs:label "time_basis" ;
	rdfs:range ubem_link:TimeBasis ;
	skos:definition "Clock to which timestamps refer (UTC, local standard time, or local time with daylight saving)." ;
	skos:inScheme ubem_link:schema .
ubem_link:timestamp_convention a owl:ObjectProperty ;
	rdfs:label "timestamp_convention" ;
	rdfs:range ubem_link:TimestampConvention ;
	skos:definition "Whether a timestamp marks the end, the start or the instant of the interval it describes." ;
	skos:inScheme ubem_link:schema .
ubem_link:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "Full title of the dataset as given by its publisher." ;
	skos:inScheme ubem_link:schema .
ubem_link:ubem_roles a owl:ObjectProperty ;
	rdfs:label "ubem_roles" ;
	rdfs:range ubem_link:UBEMRole ;
	skos:definition "UBEM workflow steps the dataset feeds; first value is the primary role." ;
	skos:inScheme ubem_link:schema .
ubem_link:unit a owl:DatatypeProperty ;
	rdfs:label "unit" ;
	skos:definition "QUDT unit CURIE, e.g. unit:FT2, unit:KiloBTU_IT, unit:KiloW-HR, unit:DEG_C." ;
	skos:inScheme ubem_link:schema .
ubem_link:unit_multiplier a owl:DatatypeProperty ;
	rdfs:label "unit_multiplier" ;
	rdfs:range xsd:float ;
	skos:definition "Factor applied to raw values before the unit applies (e.g., 1000 for \"thousand Btu\")." ;
	skos:inScheme ubem_link:schema .
ubem_link:unit_of_observation a owl:DatatypeProperty ;
	rdfs:label "unit_of_observation" ;
	skos:definition "What one record describes (building, meter, household, station, grid_cell, region, person_day, ...)." ;
	skos:inScheme ubem_link:schema .
ubem_link:update_frequency a owl:DatatypeProperty ;
	rdfs:label "update_frequency" ;
	skos:definition "How often the publisher releases new data (for example annual, irregular)." ;
	skos:inScheme ubem_link:schema .
ubem_link:variables a owl:ObjectProperty ;
	rdfs:label "variables" ;
	rdfs:range ubem_link:VariableProfile ;
	skos:definition "Variable-level profiles of the dataset's columns." ;
	skos:inScheme ubem_link:schema .
ubem_link:variables_documented a owl:DatatypeProperty ;
	rdfs:label "variables_documented" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if the publisher documents every variable (codebook or data dictionary)." ;
	skos:inScheme ubem_link:schema .
ubem_link:verified a owl:ObjectProperty ;
	rdfs:label "verified" ;
	rdfs:range ubem_link:Verification ;
	skos:definition "Provenance of the profile: who checked it, when and against which sources." ;
	skos:inScheme ubem_link:schema .
ubem_link:versioned a owl:DatatypeProperty ;
	rdfs:label "versioned" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if the publisher identifies releases with versions." ;
	skos:inScheme ubem_link:schema .
ubem_link:weather_basis a owl:DatatypeProperty ;
	rdfs:label "weather_basis" ;
	skos:definition "Weather used for the simulations (for example AMY 2018, TMY3)." ;
	skos:inScheme ubem_link:schema .
ubem_link:weather_file_format a owl:ObjectProperty ;
	rdfs:label "weather_file_format" ;
	rdfs:range ubem_link:WeatherFileFormat ;
	skos:definition "Formats in which weather is released, which decide whether a simulation engine can read it directly." ;
	skos:inScheme ubem_link:schema .
ubem_link:weather_normalized_available a owl:DatatypeProperty ;
	rdfs:label "weather_normalized_available" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if weather-normalized values are published alongside the actual ones." ;
	skos:inScheme ubem_link:schema .
ubem_link:weather_profile a owl:ObjectProperty ;
	rdfs:label "weather_profile" ;
	rdfs:range ubem_link:WeatherProfile ;
	skos:definition "Category profile for a dataset with the role boundary_conditions." ;
	skos:inScheme ubem_link:schema .
ubem_link:weather_year_type a owl:ObjectProperty ;
	rdfs:label "weather_year_type" ;
	rdfs:range ubem_link:WeatherYearType ;
	skos:definition "Kind of weather year or series: actual series, actual or typical meteorological year, normals, or projection." ;
	skos:inScheme ubem_link:schema .
