ubem_link:Distribution a owl:Class ;
	rdfs:label "Distribution" ;
	rdfs:subClassOf _:c14n103 , _:c14n143 , _:c14n159 , _:c14n196 , _:c14n225 , _:c14n228 , _:c14n230 , _:c14n264 , _:c14n323 , _:c14n340 , _:c14n59 , _:c14n71 ;
