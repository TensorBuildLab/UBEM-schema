ubem_link:Aggregation\#share a owl:Class ;
	rdfs:label "share" ;
	rdfs:subClassOf ubem_link:Aggregation ;
	skos:definition "Fraction or percentage of a whole." .
ubem_link:Aggregation\#static a owl:Class ;
	rdfs:label "static" ;
	rdfs:subClassOf ubem_link:Aggregation ;
	skos:definition "Attribute that does not vary in the observation period." .
ubem_link:Aggregation\#total_over_period a owl:Class ;
	rdfs:label "total_over_period" ;
	rdfs:subClassOf ubem_link:Aggregation ;
	skos:definition "Sum over the reporting period (for example annual energy use)." .
ubem_link:Aggregation a owl:Class ;
	rdfs:label "Aggregation" ;
