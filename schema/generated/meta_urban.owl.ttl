	skos:definition "The convention, stated as a rule that can be applied without other context." ;
	skos:inScheme meta_urban:schema .
meta_urban:sampling_weights a owl:DatatypeProperty ;
	rdfs:label "sampling_weights" ;
	skos:definition "Weight variables and how to use them (required for weighted sample surveys)." ;
	skos:inScheme meta_urban:schema .
meta_urban:schema.owl.ttl dct:license "CC-BY-4.0" ;
	dct:title "Meta-Urban metadata schema for open data in urban building energy modeling" ;
	pav:version "2.0.0" ;
	a owl:Ontology ;
	rdfs:label "meta_urban" ;
	rdfs:seeAlso <https://arxiv.org/abs/2311.08535> , <https://github.com/TensorBuildLab/UBEM-schema> ;
	skos:definition "Meta-Urban describes open datasets used in urban building energy modeling (UBEM) at two levels. The dataset level (DatasetProfile) is an application profile of W3C DCAT 3 with UBEM-specific facets: the UBEM workflow role, statistical nature, spatial granularity, temporal resolution, access level and join keys. The variable level (VariableProfile) records what each column means for UBEM: the concept it maps to in the Meta-Urban vocabulary, its unit (QUDT), its code list, its aggregation semantics, and whether it is a survey weight or an imputation flag. Concepts (UBEMConcept) form a SKOS hierarchy and carry mappings to BEDES, Brick, CityGML Energy ADE and EnergyPlus input objects." .
meta_urban:short_name a owl:DatatypeProperty ;
	rdfs:label "short_name" ;
	skos:definition "Common short name or acronym of the dataset (for example CBECS 2018)." ;
	skos:inScheme meta_urban:schema .
meta_urban:sources_checked a owl:DatatypeProperty ;
	rdfs:label "sources_checked" ;
	rdfs:range xsd:anyURI ;
	skos:definition "Pages and documents consulted during verification." ;
	skos:inScheme meta_urban:schema .
meta_urban:spatial_coverage a owl:ObjectProperty ;
	rdfs:label "spatial_coverage" ;
	rdfs:range meta_urban:SpatialCoverage ;
	skos:definition "Area the dataset covers, as countries and optional regions." ;
	skos:inScheme meta_urban:schema .
meta_urban:spatial_granularity a owl:ObjectProperty ;
	rdfs:label "spatial_granularity" ;
	rdfs:range meta_urban:SpatialGranularity ;
	skos:definition "Finest location detail released publicly." ;
	skos:inScheme meta_urban:schema .
meta_urban:start a owl:DatatypeProperty ;
	rdfs:label "start" ;
	skos:definition "First period covered (ISO 8601 year, month or date)." ;
	skos:inScheme meta_urban:schema .
meta_urban:statistical_nature a owl:ObjectProperty ;
	rdfs:label "statistical_nature" ;
	rdfs:range meta_urban:StatisticalNature ;
	skos:definition "How the data were generated, which decides how they may be analyzed (for example a weighted sample survey must be analyzed with its weights)." ;
	skos:inScheme meta_urban:schema .
meta_urban:temporal_coverage a owl:ObjectProperty ;
	rdfs:label "temporal_coverage" ;
	rdfs:range meta_urban:TemporalCoverage ;
	skos:definition "Period the data describe." ;
	skos:inScheme meta_urban:schema .
meta_urban:temporal_resolution a owl:DatatypeProperty ;
	rdfs:label "temporal_resolution" ;
	rdfs:range _:c14n159 ;
	skos:definition "ISO 8601 duration of the finest time step, or \"static\" or \"irregular\"." ;
	skos:inScheme meta_urban:schema .
meta_urban:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "Full title of the dataset as given by its publisher." ;
	skos:inScheme meta_urban:schema .
meta_urban:ubem_roles a owl:ObjectProperty ;
	rdfs:label "ubem_roles" ;
	rdfs:range meta_urban:UBEMRole ;
	skos:definition "UBEM workflow steps the dataset feeds; first value is the primary role." ;
	skos:inScheme meta_urban:schema .
meta_urban:unit a owl:DatatypeProperty ;
	rdfs:label "unit" ;
	skos:definition "QUDT unit CURIE, e.g. unit:FT2, unit:KiloBTU_IT, unit:KiloW-HR, unit:DEG_C." ;
	skos:inScheme meta_urban:schema .
meta_urban:unit_multiplier a owl:DatatypeProperty ;
	rdfs:label "unit_multiplier" ;
	rdfs:range xsd:float ;
	skos:definition "Factor applied to raw values before the unit applies (e.g., 1000 for \"thousand Btu\")." ;
	skos:inScheme meta_urban:schema .
meta_urban:unit_of_observation a owl:DatatypeProperty ;
	rdfs:label "unit_of_observation" ;
	skos:definition "What one record describes (building, meter, household, station, grid_cell, region, person_day, ...)." ;
	skos:inScheme meta_urban:schema .
meta_urban:update_frequency a owl:DatatypeProperty ;
	rdfs:label "update_frequency" ;
	skos:definition "How often the publisher releases new data (for example annual, irregular)." ;
	skos:inScheme meta_urban:schema .
meta_urban:variables a owl:ObjectProperty ;
	rdfs:label "variables" ;
	rdfs:range meta_urban:VariableProfile ;
	skos:definition "Variable-level profiles of the dataset's columns." ;
	skos:inScheme meta_urban:schema .
meta_urban:variables_documented a owl:DatatypeProperty ;
	rdfs:label "variables_documented" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if the publisher documents every variable (codebook or data dictionary)." ;
	skos:inScheme meta_urban:schema .
meta_urban:verified a owl:ObjectProperty ;
	rdfs:label "verified" ;
	rdfs:range meta_urban:Verification ;
	skos:definition "Provenance of the profile: who checked it, when and against which sources." ;
	skos:inScheme meta_urban:schema .
meta_urban:versioned a owl:DatatypeProperty ;
	rdfs:label "versioned" ;
	rdfs:range xsd:boolean ;
	skos:definition "True if the publisher identifies releases with versions." ;
	skos:inScheme meta_urban:schema .
