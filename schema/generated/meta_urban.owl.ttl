skos:broadMatch a owl:Class ;
	rdfs:label "broadMatch" ;
	rdfs:subClassOf meta_urban:MappingRelation ;
	skos:definition "The concept is more general than the variable." .
skos:closeMatch a owl:Class ;
	rdfs:label "closeMatch" ;
	rdfs:subClassOf meta_urban:MappingRelation ;
	skos:definition "The variable measures nearly the concept and can be used in its place in most applications." .
skos:exactMatch a owl:Class ;
	rdfs:label "exactMatch" ;
	rdfs:subClassOf meta_urban:MappingRelation ;
	skos:definition "The variable measures exactly the concept." .
skos:narrowMatch a owl:Class ;
	rdfs:label "narrowMatch" ;
	rdfs:subClassOf meta_urban:MappingRelation ;
	skos:definition "The concept is more specific than the variable." .
skos:relatedMatch a owl:Class ;
	rdfs:label "relatedMatch" ;
	rdfs:subClassOf meta_urban:MappingRelation ;
	skos:definition "The variable is associated with the concept but does not measure it." .
