	rdfs:subClassOf _:c14n106 , _:c14n112 , _:c14n115 , _:c14n116 , _:c14n123 , _:c14n141 , _:c14n162 , _:c14n181 , _:c14n185 , _:c14n189 , _:c14n201 , _:c14n218 , _:c14n235 , _:c14n24 , _:c14n246 , _:c14n250 , _:c14n265 , _:c14n266 , _:c14n289 , _:c14n291 , _:c14n297 , _:c14n298 , _:c14n311 , _:c14n316 , _:c14n318 , _:c14n319 , _:c14n325 , _:c14n326 , _:c14n332 , _:c14n39 , _:c14n52 , _:c14n70 , _:c14n89 , _:c14n91 , _:c14n92 , _:c14n97 ;
	skos:definition "A concept in the Meta-Urban vocabulary: a quantity or attribute that a UBEM workflow consumes or produces (for example floor area, principal building activity, dry-bulb temperature, annual electricity use). Concepts form a hierarchy through `broader` and point to equivalent terms in other standards." ;
	skos:exactMatch skos:Concept ;
	skos:inScheme meta_urban:schema .
meta_urban:UBEMRole\#boundary_conditions a owl:Class ;
	rdfs:label "boundary_conditions" ;
	rdfs:subClassOf meta_urban:UBEMRole ;
	skos:definition "Weather and climate drivers (observed, reanalysis, typical-year, projections)." .
meta_urban:UBEMRole\#building_characteristics a owl:Class ;
	rdfs:label "building_characteristics" ;
	rdfs:subClassOf meta_urban:UBEMRole ;
	skos:definition "Non-geometric attributes (use type, vintage, envelope, systems, fuels, floor area)." .
meta_urban:UBEMRole\#calibration_validation a owl:Class ;
	rdfs:label "calibration_validation" ;
	rdfs:subClassOf meta_urban:UBEMRole ;
	skos:definition "Measured or reported energy use at any scale." .
meta_urban:UBEMRole\#context_coupling a owl:Class ;
	rdfs:label "context_coupling" ;
	rdfs:subClassOf meta_urban:UBEMRole ;
	skos:definition "Socio-economic, land use, grid emissions, tariffs, urban microclimate." .
meta_urban:UBEMRole\#geometry_inventory a owl:Class ;
	rdfs:label "geometry_inventory" ;
	rdfs:subClassOf meta_urban:UBEMRole ;
	skos:definition "Location and shape of buildings (footprints, heights, 3D models, parcels)." .
meta_urban:UBEMRole\#operation_use a owl:Class ;
	rdfs:label "operation_use" ;
	rdfs:subClassOf meta_urban:UBEMRole ;
	skos:definition "Occupancy, schedules, occupant behavior, setpoints, plug loads." .
meta_urban:UBEMRole\#reference_simulation a owl:Class ;
	rdfs:label "reference_simulation" ;
	rdfs:subClassOf meta_urban:UBEMRole ;
	skos:definition "Synthetic building-stock model outputs and model libraries." .
meta_urban:UBEMRole a owl:Class ;
	rdfs:label "UBEMRole" ;
	owl:unionOf _:c14n1 ;
	skos:definition "The UBEM workflow step a dataset or concept serves." ;
	skos:inScheme meta_urban:schema ;
