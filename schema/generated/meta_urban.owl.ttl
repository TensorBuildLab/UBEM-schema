meta_urban:Convention a owl:Class ;
	rdfs:label "Convention" ;
	rdfs:subClassOf _:c14n135 , _:c14n165 , _:c14n197 , _:c14n275 , _:c14n282 , _:c14n300 , _:c14n315 , _:c14n38 , _:c14n75 ;
	skos:definition "A rule the publisher applies to many variables at once, such as a naming pattern for imputation flags, a code that means \"not applicable\", or a unit used for all energy totals. Conventions are usually stated once in a user guide and never in the individual codebook entries, so a person or an AI system reading one entry cannot infer them; the profile states them explicitly." ;
	skos:inScheme meta_urban:schema .
